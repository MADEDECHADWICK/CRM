generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Defines the three confirmed user roles in the CRM.
///
/// MARKETING_BD:
/// Users responsible for business development and managing opportunities.
///
/// PARTNER:
/// Senior users who require visibility into relevant business opportunities.
///
/// MANAGER:
/// Users responsible for managing and monitoring opportunities within
/// their authorized scope.
enum Role {
  MARKETING_BD
  PARTNER
  MANAGER
}

/// Represents the lifecycle stage of an opportunity.
///
/// An Opportunity moves through these stages as the relationship
/// with an organization progresses.
///
/// We keep the stage on Opportunity for quick access to its current state,
/// while StageHistoryEntry preserves the complete history of transitions.
enum Stage {
  /// An organization or potential business opportunity identified
  /// but not yet actively qualified.
  PROSPECT

  /// An active business opportunity that is being pursued.
  LEAD

  /// A formal proposal has been prepared.
  PROPOSAL

  /// The proposal has been sent to the client and is awaiting their
  /// feedback. Distinct from NO_REPLY: the client still has a normal
  /// window in which to respond, so this is not yet an outcome.
  AWAITING_FEEDBACK

  /// The BD-issued drafting deadline passed and nothing was submitted.
  ///
  /// Set by the system, never by a user, and deliberately RECOVERABLE —
  /// a proposal that was 90% written should not be destroyed permanently
  /// because a date slipped. Going back to PROPOSAL is a normal, expected
  /// recovery and is the single most common transition out of this stage.
  ///
  /// Arriving here also raises a note debt (see Opportunity.breachNoteRequired):
  /// the assignee owes an explanation, but after the fact, not at the moment
  /// the system acted on their behalf (BR-019).
  NOT_SUBMITTED

  /// The opportunity was successfully converted into business.
  WON

  /// The opportunity was unsuccessful.
  LOST

  /// The organization has not provided a response.
  NO_REPLY

  /// The opportunity has been postponed and may be revisited later.
  DEFERRED
}

/// Represents the completion state of a follow-up.
///
/// This is intentionally separate from Stage because a follow-up
/// is an activity, while Stage represents the overall state
/// of a business opportunity.
enum FollowupStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Where a lead came from.
///
/// Required on every opportunity (BR-018). Channel attribution is what makes
/// marketing spend measurable — without it the firm is guessing which channels
/// produce revenue. `OTHER` exists so an unexpected channel is still recorded
/// as a real answer rather than forcing users to leave the field blank or
/// abandon the form.
enum LeadSource {
  /// An existing client or business contact referred them.
  REFERRAL

  /// A Partner inside the firm made the introduction.
  PARTNER_REFERRAL

  /// Walked into the firm's premises.
  WALK_IN

  /// Enquiry through the firm's own website.
  WEBSITE

  /// Social media platforms.
  SOCIAL_MEDIA

  /// A specific marketing campaign the firm funded.
  MARKETING_CAMPAIGN

  /// A trade show, seminar or conference.
  EXHIBITION

  /// A public or private tender the firm bid for.
  TENDER

  /// Firm-initiated outbound prospecting.
  COLD_OUTREACH

  /// A real channel that is none of the above — described in leadSourceNote.
  OTHER
}

/// Who performed a stage transition.
///
/// Almost every transition is a person making a decision and BR-010 requires
/// their reason. The overdue sweep is not: a scheduled job moved the deal, so
/// there is no human to attribute and no reason to give. Without this the
/// audit trail — the system's best feature — could not record the one
/// transition that most needs recording.
enum ActorType {
  /// A signed-in user acting deliberately.
  USER

  /// The automated deadline sweep.
  SYSTEM
}

/// Represents the kind of follow-up activity (BRD / ERD).
enum FollowupType {
  CALL
  EMAIL
  MEETING
}

/// How a proposal was submitted to the client.
///
/// Review request: RFP and RFQ are reported together, prequalifications
/// separately. Kept as its own enum rather than a boolean so a third kind can
/// be added without a schema rewrite.
enum SubmissionType {
  RFP
  RFQ
  PREQUALIFICATION
}

/// The commercial nature of a won job.
///
/// Review request: new business vs cross-selling vs upselling — this is what
/// makes "client acquisition" and "account expansion" reportable.
enum BusinessType {
  NEW_BUSINESS
  CROSS_SELL
  UPSELL
}

/// Represents a system user.
///
/// Users interact with opportunities, create notes,
/// schedule follow-ups, and may change opportunity stages.
model User {
  /// Primary identifier using UUID to avoid exposing sequential IDs.
  id String @id @default(uuid())

  passwordHash String?

  /// User's full name for identification throughout the CRM.
  name String

  /// Email is unique because it will be used as a login identifier.
  email String @unique

  /// Stores the user's authorization role.
  ///
  /// Role controls what type of access the user has in the CRM.
  role Role

  /// Optional department association.
  ///
  /// This can support department-based visibility rules later.
  /// It remains optional because senior users such as Partners may
  /// not necessarily belong to only one operational department.
  departmentId String?

  /// Reference to the user's primary department.

  department          Department?         @relation("DepartmentUsers", fields: [departmentId], references: [id])

  /// Departments this user is appointed to run.
  ///
  /// Partners may lead several departments independently of primary membership.
  headedDepartments   Department[]        @relation("DepartmentHead")

  assignedProspects Organization[] @relation("ProspectAssignee")
  prospectAssignmentsMade Organization[] @relation("ProspectAssignedBy")

  /// Opportunities created by this user.
  createdOpprtunites  Opportunity[]       @relation("OpportunityCreatedBy")
  /// Opportunities currently owned or managed by this user.
  ///
  /// Ownership is separate from creation because an opportunity
  /// may be transferred between users.
  ownerOpportunities  Opportunity[]       @relation("OpportunityOwner")

  /// Opportunities this Partner signed (review: "signing partner").
  ///
  /// Distinct from ownership: the owner runs the deal, the signing partner
  /// puts their name to the engagement.
  signedOpportunities Opportunity[]       @relation("OpportunitySigningPartner")
  /// Stage changes performed by this user.
  stageHistoryEntries StageHistoryEntry[] @relation("StageChangedBy")

  /// Deadlines this user issued to other people (BR-016).
  ///
  /// Kept as a real relation rather than a bare id so "every deadline Grace
  /// has set, and how those deals turned out" is a query, not a report
  /// somebody reconstructs by hand.
  deadlinesIssued      Opportunity[]       @relation("OpportunityDeadlineSetBy")

  /// Notes created by this user.
  notes Note[]

  /// Ownership handovers where this user was the previous owner.
  ownershipHandoversFrom OwnerChange[] @relation("OwnerChangeFrom")

  /// Ownership handovers where this user became the owner.
  ownershipHandoversTo   OwnerChange[] @relation("OwnerChangeTo")

  /// Ownership handovers this user performed, whether or not they were
  /// involved in the deal as owner.
  ownershipChangesMade   OwnerChange[] @relation("OwnerChangeBy")

  /// Follow-ups assigned to this user.
  assignedFollowups Followup[] @relation("FollowupAssignedTo")
  /// Follow-ups created by this user.
  createdFollowups  Followup[] @relation("FollowupCreatedBy")
  /// Timestamp recording when the user was created.
  createdAt         DateTime   @default(now())

  /// Automatically updated whenever the user record changes.
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([role])
}

/// Represents a business department within the organization.
///
/// Departments are deliberately modeled separately because an
/// organization may have multiple independent opportunities
/// with different departments.
///
/// Example:
///
/// ABC Ltd
/// ├── Opportunity with Audit Department
/// └── Opportunity with Consulting Department
///
/// Therefore, Department belongs to Opportunity rather than
/// assigning one global department directly to Organization.
model Department {
  assignedAccounts Organization[] @relation("AccountDepartmentAssignment")
  /// Primary UUID identifier.
  id String @id @default(uuid())

  /// Human-readable department name.
  ///
  /// Example:
  /// Audit
  /// Consulting
  /// Technology
  name String @unique

  /// Optional explanation of the department's purpose.
  description String?

  /// The person appointed to run this department.
  ///
  /// A Partner may head several departments.
  headId String?

  /// The department head, when one has been appointed.
  ///
  /// SetNull rather than Restrict: removing a user must never delete a
  /// department. An unheaded department is a gap to fill, not a cascade.
  head User? @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  /// Users primarily associated with this department.
  ///
  /// Distinct from Department.head: this is membership, that is command.
  /// A department has one head and any number of members, so the two facts
  /// genuinely differ and are stored separately.
  users User[] @relation("DepartmentUsers")

  /// Opportunities being handled by this department.
  opportunities Opportunity[]

  /// Timestamp recording when the department was created.
  createdAt DateTime @default(now())

  /// Automatically updated whenever the department changes.
  updatedAt DateTime @updatedAt
  @@index([headId])
}

/// Represents an external organization or company.
///
/// Organization is intentionally separated from Opportunity.
///
/// One organization can have multiple business opportunities
/// at the same time, potentially across different departments.
model Organization {
  /// Primary UUID identifier.
  id String @id @default(uuid())

  /// Official organization name.
  name String

  /// Short client reference number (review: "client number"). Unique when set
  /// so the same client cannot be filed twice under different numbers.
  clientNumber String? @unique

  /// Optional industry classification.
  ///
  /// This supports segmentation and reporting without making
  /// industry mandatory during initial data capture.
  industry String?

  /// Country of the client — drives the country-level management reports.
  country String?

  /// Optional website.
  website String?

  /// Primary organization email.
  email String?

  /// Primary organization phone number.
  phone String?

  /// Optional physical address.
  address String?

  /// Optional general notes about the organization.
  ///
  /// Detailed chronological notes belong in the Note model.
  description String?

  /// Existing customer records do not imply a won opportunity or revenue.
  isExistingClient Boolean @default(false)

  /// Stable import identity; prevents duplicate accounts on a repeated import.
  sourceKey String? @unique

  /// Original worksheet references and business metadata, without fabricated
  /// opportunities, ownership, fees, contact details, or lifecycle dates.
  sourceData Json?

  /// Directory responsibility, independent of opportunity ownership/revenue.
  assignedToId String?
  assignedTo User? @relation("ProspectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedById String?
  assignedBy User? @relation("ProspectAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt DateTime?
  assignedDepartmentId String?
  assignedDepartment Department? @relation("AccountDepartmentAssignment", fields: [assignedDepartmentId], references: [id], onDelete: SetNull)

  /// All business opportunities associated with this organization.
  /// This relationship is critical because an organization can
  /// have multiple independent opportunities.
  opportunities Opportunity[]

  /// Notes optionally linked to this organization (BR-011 — a reminder
  /// with no CRM context at all is still valid, so both links are optional).
  notes Note[]

  /// Follow-ups optionally linked to this organization.
  followups Followup[]

  /// Named people who work at this organization.
  ///
  /// Organization.email / phone hold the generic switchboard details, so a
  /// Contact is the named person you actually email or call — the thing a
  /// BD needs before a site visit.
  contacts Contact[]

  /// Timestamp recording when the organization was added.
  createdAt DateTime @default(now())

  /// Automatically updated whenever organization data changes.
  updatedAt DateTime @updatedAt

  /// Index supports faster organization searches.
  @@index([name])
  /// Index supports industry-based filtering and reporting.
  @@index([industry])
  /// Index supports country-level reporting.
  @@index([country])
  @@index([assignedToId])
  @@index([assignedDepartmentId])
}

/// Represents a named contact person at a client organization.
///
/// This is deliberately separate from Organization.email / phone, which hold
/// the generic company details. A Contact is the individual person — their
/// name, role, and direct reachability — so outreach can be directed at a
/// specific decision maker rather than a switchboard.
model Contact {
  /// Primary UUID identifier.
  id String @id @default(uuid())

  /// The contact person's full name.
  ///
  /// Example:
  ///
  /// "Jane Mwangi"
  name String

  /// Optional job title or role at the organization.
  ///
  /// Example:
  ///
  /// "Head of Finance"
  title String?

  /// Optional department the person sits in.
  ///
  /// Free text rather than a Department relation because this describes the
  /// client's internal structure, not ours.
  department String?

  /// The person's email address.
  email String?

  /// The person's phone number.
  phone String?

  /// Marks the main point of contact for the organization.
  ///
  /// At most one contact per organization should be primary, but the flag is
  /// kept as a plain boolean so the constraint is enforced in the API layer
  /// where the rest of the validation lives.
  isPrimary Boolean @default(false)

  /// Optional free-text notes about this person.
  notes String?

  /// Organization this person belongs to.
  organizationId String

  /// Relationship to the organization employing this contact.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Timestamp recording when the contact was added.
  createdAt DateTime @default(now())

  /// Automatically updated whenever the contact record changes.
  updatedAt DateTime @updatedAt

  /// Supports loading all contacts for an organization in one query.
  @@index([organizationId])
  /// Supports surfacing primary contacts across organizations.
  @@index([isPrimary])
}

/// Represents a specific business opportunity.
///
/// Opportunity is the central entity in this CRM architecture.
///
/// Instead of treating "Lead", "Proposal", and "Client" as completely
/// separate entities, an opportunity progresses through stages.
///
/// Example:
///
/// PROSPECT
///     ↓
/// LEAD
///     ↓
/// PROPOSAL
///     ↓
/// WON / LOST / NO_REPLY / DEFERRED
///
/// The organization relationship identifies WHO the opportunity is with.
///
/// The department relationship identifies WHICH internal department
/// is pursuing the opportunity.
///
/// This solves the problem where one organization may simultaneously
/// have opportunities with multiple departments.
model Opportunity {
  /// Primary UUID identifier.
  id String @id @default(uuid())

  /// Short descriptive name for the opportunity.
  ///
  /// Example:
  /// "FY2026 External Audit Engagement"
  title String

  /// Detailed explanation of the business opportunity.
  description String?

  /// Current lifecycle stage.
  ///
  /// This stores the latest stage for fast querying.
  ///
  /// Historical changes are stored separately in StageHistoryEntry.
  stage Stage @default(PROSPECT)

  /// Estimated or proposed monetary value of the opportunity.
  ///
  /// Decimal is used instead of Float to prevent financial
  /// precision problems.
  amount Decimal? @db.Decimal(18, 2)

  /// Currency code associated with the opportunity amount.
  ///
  /// Example:
  /// KES
  /// USD
  ///
  /// Keeping currency separate supports future multi-currency use.
  currency String @default("KES")

  /// The service being offered by the pursuing department.
  ///
  /// BR-003 makes this mandatory at creation — a lead cannot exist
  /// without an organization, the department pursuing it, and the
  /// service being offered.
  ///
  /// Example:
  /// "FY2027 Statutory Audit"
  service String

  /// The moment the opportunity entered its current stage.
  ///
  /// Resets on every transition — this is what powers "days in stage"
  /// reporting instead of relying on createdAt or updatedAt.
  stageEnteredAt DateTime @default(now())

  /// Where this lead came from (BR-018).
  ///
  /// Mandatory at creation, with no database default on purpose. A default
  /// would let a buggy or forgotten write path quietly record OTHER and the
  /// channel data would be quietly, permanently wrong. Backfilled as OTHER
  /// during migration because "we did not record it" is a more honest value
  /// than guessing a channel after the fact.
  leadSource LeadSource

  /// Free text describing the lead source, required only when
  /// leadSource = OTHER so that bucket is never empty.
  leadSourceNote String?

  /// When the lead itself arrived, as distinct from when the record was typed
  /// in. Defaults to createdAt but is separately settable because BD often
  /// backfills a lead days after the conversation happened, and the whole
  /// velocity analysis is wrong if that distortion is not corrected.
  leadReceivedAt DateTime @default(now())

  /// The INTERNAL deadline the BD set for drafting this proposal (BR-016).
  ///
  /// This is deliberately NOT the date the proposal goes to the client. It is
  /// the date by which the draft must be finished, reviewed and amended, so
  /// that BD and marketing still have room to make changes before submission.
  /// Conflating the two destroys the only measurement that shows how long
  /// the firm actually takes to write a proposal.
  ///
  /// Drives the RAG indicator and the overdue sweep. Null means no deadline
  /// has been issued yet, which is a legitimate state — not every lead is
  /// being actively drafted.
  proposalDueAt DateTime?

  /// The BD who issued the deadline.
  ///
  /// Recorded so "who gave this person six days, and when?" is answerable —
  /// the accountability the whole deadline system rests on.
  proposalDueSetById String?

  /// Relationship to the BD who issued the deadline.
  proposalDueSetBy    User?     @relation("OpportunityDeadlineSetBy", fields: [proposalDueSetById], references: [id], onDelete: SetNull)

  /// When the deadline was issued. Distinct from proposalDueAt so a deadline
  /// given today for next month shows as six days' notice, not a month.
  proposalDueSetAt DateTime?

  /// When the finished proposal actually went to the client (BR-016).
  ///
  /// Stamped automatically the moment the deal moves to AWAITING_FEEDBACK —
  /// that transition IS the act of sending, so it is the only trustworthy
  /// moment to record. Together with proposalDueAt this yields
  /// "days from deadline issued to proposal sent", the core BD metric.
  proposalSubmittedAt DateTime?

  /// When the system moved this deal to NOT_SUBMITTED.
  proposalBreachedAt DateTime?

  /// Whether the assignee still owes an explanation for a missed deadline
  /// (BR-019).
  ///
  /// Raised by the system the moment it flags a missed deadline, and cleared
  /// only when the assignee actually writes the note. This is the honest
  /// reading of the requirement: the flag is automatic, but the obligation to
  /// account for it is real and is tracked separately.
  breachNoteRequired Boolean @default(false)

  /// When the breach explanation is due — the note is owed *after* the flag,
  /// not at the instant the system acted on the assignee's behalf.
  breachNoteDueAt DateTime?

  /// When the assignee cleared the breach note debt.
  breachNoteClearedAt DateTime?

  /// Set only when stage = DEFERRED.
  ///
  /// BR-008 requires a future revisit date when deferring, and the
  /// automatic follow-up reminder generated at that time is scheduled
  /// against this date.
  revisitAt DateTime?

  /// Optional structured reason for a LOST outcome (BR-007).
  ///
  /// "Client decided to postpone indefinitely" vs "Pricing too high"
  /// — kept separate from the mandatory decision note so lost-opportunity
  /// reporting can be structured without forcing quotes into free text.
  lostReason String?

  /// How this proposal was submitted (review: RFP/RFQ together,
  /// prequalifications reported separately). Null until a proposal exists.
  submissionType SubmissionType?

  /// For a WON job: new business, cross-selling or upselling (review:
  /// account-acquisition vs account-expansion reporting). Null until won.
  businessType BusinessType?

  /// The Partner who signed the engagement (review: "signing partner").
  ///
  /// Distinct from the owner: the owner runs the deal day to day, the signing
  /// partner puts their name to it. SetNull on delete so removing a user never
  /// deletes the deal.
  signingPartnerId String?

  /// Relationship to the signing Partner.
  signingPartner   User?  @relation("OpportunitySigningPartner", fields: [signingPartnerId], references: [id], onDelete: SetNull)

  /// Reference to the external organization.
  organizationId String

  /// The organization involved in this opportunity.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Reference to the internal department handling this opportunity.
  ///
  /// Department belongs to the Opportunity rather than Organization
  /// because the same organization can engage multiple departments.
  departmentId String

  /// Internal department responsible for pursuing the opportunity.
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  /// User who originally created the opportunity.
  createdById String

  /// Relationship to the user who created the opportunity.
  createdBy User    @relation("OpportunityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// User currently responsible for managing the opportunity.
  ///
  /// Ownership is separate from createdBy because responsibility
  /// can change during the opportunity lifecycle.
  ownerId   String?

  /// Current opportunity owner.
  owner        User?               @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Complete record of every stage transition.
  stageHistory StageHistoryEntry[]

  /// Notes associated with this opportunity.
  notes Note[]

  /// Every change of owner, oldest first when ordered by changedAt.
  ///
  /// Reassignment is a first-class decision in this business — a Manager or
  /// Partner hands a deal on when they cannot execute it — so it gets a real
  /// table rather than a line of free text in Note. Note has no type
  /// discriminator, which meant a handover was indistinguishable from any other
  /// note and "who had this deal, and when did it move?" was unanswerable
  /// without reading prose.
  ownerChanges OwnerChange[]

  /// Follow-up activities associated with this opportunity.
  followups Followup[]

  /// Date the opportunity was first created.
  createdAt DateTime @default(now())

  /// Automatically updated whenever the opportunity changes.
  updatedAt DateTime @updatedAt

  /// Optional date when the opportunity was successfully won.
  ///
  /// This is useful for revenue reporting and conversion analysis.
  wonAt DateTime?

  /// Optional date when the opportunity was closed as unsuccessful.
  ///
  /// This allows reporting on lost opportunities without
  /// relying only on updatedAt.
  lostAt DateTime?

  /// Supports filtering opportunities by organization.
  @@index([organizationId])
  /// Supports department-specific pipeline queries.
  @@index([departmentId])
  /// Supports filtering by current owner.
  @@index([ownerId])
  /// Supports pipeline queries by stage.
  @@index([stage])
  /// Useful for common dashboard queries.
  @@index([departmentId, stage])
  /// Useful for organization-specific opportunity views.
  @@index([organizationId, stage])
  /// Drives the overdue sweep: "anything in a drafting stage whose internal
  /// deadline has passed and that was never submitted".
  @@index([stage, proposalDueAt])
  /// Supports the RAG column in list views without loading every row first.
  @@index([proposalDueAt])
  /// Channel attribution reporting (BR-018).
  @@index([leadSource])
  /// Reporting period filters and the pipeline list's `orderBy stageEnteredAt`
  /// both key on this; without it the aggregates and the default sort scan the
  /// whole table.
  @@index([stageEnteredAt])
  /// The period filters always combine a stage with the entered-at window.
  @@index([stage, stageEnteredAt])
  /// Channel-attribution reporting windows deals by when the lead arrived.
  @@index([leadReceivedAt])
  /// The breach-escalation queue and the open-note report counts filter on
  /// exactly this pair.
  @@index([breachNoteRequired, breachNoteDueAt])
  /// A Manager's reports and pipeline are scoped by owner + the period window,
  /// so this lets the aggregate range-scan instead of scanning every deal they
  /// own and filtering.
  @@index([ownerId, stageEnteredAt])
  /// Submission-type reporting (RFP/RFQ vs prequalification).
  @@index([submissionType])
  /// Business-type reporting (new business / cross-sell / upsell).
  @@index([businessType])
  /// Signing-partner reporting.
  @@index([signingPartnerId])
}

/// Records every stage transition made to an Opportunity.
///
/// We do not rely only on Opportunity.stage because overwriting
/// the current stage would destroy historical information.
///
/// Example:
///
/// PROSPECT → LEAD
/// LEAD → PROPOSAL
/// PROPOSAL → WON
///
/// Each transition becomes a permanent historical record.
model StageHistoryEntry {
  /// Primary UUID identifier.
  id String @id @default(uuid())

  /// Opportunity whose stage changed.
  opportunityId String

  /// Relationship to the relevant opportunity.
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Previous stage.
  ///
  /// Nullable because the first history entry may represent
  /// the initial creation of an opportunity.
  fromStage Stage?

  /// New stage after the transition.
  toStage Stage

  /// User who performed the stage change.
  ///
  /// Nullable only for ActorType.SYSTEM: the automated deadline sweep has no
  /// human actor. Every user-initiated transition still has one, so BR-010's
  /// mandatory reason keeps being enforced on exactly the transitions where
  /// a person is genuinely making a decision.
  changedById String?

  /// Relationship to the user who changed the stage.
  changedBy User?  @relation("StageChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  /// Whether a person or the automated sweep made this transition.
  ///
  /// Read together with changedById, never instead of it: a USER row with no
  /// actor, or a SYSTEM row that somehow has one, is corrupt data and is
  /// rejected in the API layer rather than quietly stored.
  actorType ActorType @default(USER)

  /// Why the system acted, when actorType = SYSTEM.
  ///
  /// Records the fact that drove the automated decision ("BD drafting
  /// deadline of 2026-10-01 passed with nothing submitted") so an automatic
  /// transition is as explainable to a human reader as a manual one.
  systemReason String?

  /// Optional explanation for the stage transition.
  ///
  /// Particularly useful when marking an opportunity LOST,
  /// DEFERRED, or NO_REPLY.
  reason String?

  /// Exact time when the stage change occurred.
  changedAt DateTime @default(now())

  /// Supports retrieving an opportunity's timeline in order.
  @@index([opportunityId, changedAt])
  /// Supports audit queries by user.
  @@index([changedById])
}

/// Records every change of owner on an Opportunity.
///
/// Opportunity.ownerId holds who owns it *now* and answers "who do I ask?".
/// This table holds how it got that way, and answers the two questions that
/// ownership questions actually turn into: "how long has Grace had the Tax
/// mandate?" and "who keeps passing work on instead of running it?"
///
/// The initial assignment is written here too, with fromOwnerId null, so the
/// history is complete from the moment the deal exists. Starting it at the
/// first handover would leave every deal looking as though it appeared from
/// nowhere.
model OwnerChange {
  /// Primary UUID identifier.
  id String @id @default(uuid())

  /// Opportunity whose owner changed.
  opportunityId String

  /// The opportunity in question.
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// The previous owner.
  ///
  /// Null only on the initial assignment, where there was nobody before. Never
  /// null on a handover: moving a deal to "nobody" is not a thing the business
  /// does, so a missing from-owner on a later row means data loss, not intent.
  fromOwnerId String?

  /// Who owned the deal before this change.
  fromOwner User? @relation("OwnerChangeFrom", fields: [fromOwnerId], references: [id], onDelete: SetNull)

  /// The new owner.
  toOwnerId String

  /// Who owns the deal after this change.
  toOwner User @relation("OwnerChangeTo", fields: [toOwnerId], references: [id], onDelete: Restrict)

  /// Who made the change.
  ///
  /// Not the same as toOwnerId: a Partner handing a deal to a Manager is the
  /// author of the handover but not its beneficiary, and a report asking "who
  /// reassigned this?" needs the author.
  changedById String

  /// The person who performed the handover.
  changedBy User @relation("OwnerChangeBy", fields: [changedById], references: [id], onDelete: Restrict)

  /// Why the deal moved.
  ///
  /// Mandatory and not nullable, including on the initial assignment — the
  /// same BR-010 discipline that forces a reason on a stage transition. An
  /// unexplained handover is how a deal ends up quietly parked with nobody
  /// accountable for it.
  reason String

  /// Exact time of the handover.
  changedAt DateTime @default(now())

  /// The ownership timeline, newest first, for one opportunity.
  @@index([opportunityId, changedAt])
  /// "What has Grace been handed?" across the whole book.
  @@index([toOwnerId])
  /// "What has Grace handed on?" — the workload-balance question.
  @@index([fromOwnerId])
  /// Audit by actor.
  @@index([changedById])
}

/// Represents a contextual note attached to an Opportunity.
///
/// Notes are separated from the Opportunity description because
/// CRM notes are chronological and should not overwrite each other.
///
/// Example:
///
/// Jan 10 - Initial meeting completed
/// Jan 15 - Client requested revised proposal
/// Jan 20 - Awaiting management decision
model Note {
  /// Primary UUID identifier.
  id String @id @default(uuid())

  /// Main content of the note.
  ///
  /// Text is used because CRM notes can vary significantly in length.
  body String @db.Text

  /// Opportunity this note belongs to (optional).
  opportunityId String?

  /// Relationship to the relevant opportunity, if any.
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// Organization this note belongs to (optional).
  organizationId String?

  /// Relationship to the relevant organization, if any.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// User who created the note.
  authorId     String

  /// Relationship to the note author.
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  /// Timestamp recording when the note was created.
  createdAt DateTime @default(now())

  /// Automatically updated if the note is edited.
  updatedAt DateTime @updatedAt

  /// Supports loading notes for an opportunity chronologically.
  @@index([opportunityId, createdAt])
  /// Supports loading notes for an organization chronologically.
  @@index([organizationId, createdAt])
  /// Supports user activity queries.
  @@index([authorId])
}

/// Represents a scheduled follow-up activity.
///
/// Follow-ups are attached directly to Opportunity because the
/// follow-up exists in the context of a specific business pursuit.
///
/// This prevents generic tasks from becoming disconnected from
/// the CRM pipeline.
model Followup {
  /// Primary UUID identifier.
  id String @id @default(uuid())

  /// Kind of follow-up activity (BRD & ERD).
  type FollowupType @default(CALL)

  /// Short description of the follow-up.
  ///
  /// Example:
  /// "Call client regarding proposal feedback"
  note String

  /// Whether the reminder also links to an opportunity's organization.
  ///
  /// BR-011 keeps both links optional — a reminder with no CRM context
  /// at all is still a valid, personal follow-up.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Current completion state.
  status FollowupStatus @default(PENDING)

  /// Date and time when the follow-up should happen.
  dueAt DateTime

  /// Date and time when the follow-up was completed.
  ///
  /// Null until completion.
  completedAt DateTime?

  /// Opportunity this follow-up belongs to.
  opportunityId String?

  /// Relationship to the relevant opportunity.
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// User responsible for completing the follow-up.
  assignedToId String?

  /// Relationship to the assigned user.
  assignedTo  User?  @relation("FollowupAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// User who originally created the follow-up.
  createdById String

  /// Relationship to the user who created it.
  createdBy User     @relation("FollowupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// Timestamp recording when the follow-up was created.
  createdAt DateTime @default(now())

  /// Automatically updated when the follow-up changes.
  updatedAt DateTime @updatedAt

  /// Supports dashboard queries for pending follow-ups.
  @@index([status])
  /// Supports queries for upcoming and overdue follow-ups.
  @@index([dueAt])
  /// Supports user-specific task views.
  @@index([assignedToId])
  /// The personal-scope list matches on createdById as well as assignedToId.
  @@index([createdById])
  /// Supports loading follow-ups within an opportunity.
  @@index([opportunityId, dueAt])
  /// Supports loading follow-ups within an organization.
  @@index([organizationId, dueAt])
}
